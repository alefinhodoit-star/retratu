{
  "name": "CategoriaLoja",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da categoria apresentado na loja"
    },
    "slug": {
      "type": "string",
      "description": "Identificador usado no endere\u00e7o da sec\u00e7\u00e3o e nos produtos"
    },
    "curto": {
      "type": "string",
      "description": "Nome curto usado nos bot\u00f5es de navega\u00e7\u00e3o"
    },
    "resumo": {
      "type": "string"
    },
    "ordem": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }