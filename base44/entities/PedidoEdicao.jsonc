{
  "name": "PedidoEdicao",
  "type": "object",
  "properties": {
    "referencia": {
      "type": "string",
      "description": "N\u00famero de refer\u00eancia devolvido ao cliente ap\u00f3s o registo do pedido"
    },
    "servico_principal": {
      "type": "string",
      "description": "Identificador do servi\u00e7o principal escolhido no assistente"
    },
    "servico_nome": {
      "type": "string",
      "description": "Nome leg\u00edvel do servi\u00e7o principal"
    },
    "servicos_complementares": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Edi\u00e7\u00f5es complementares escolhidas pelo cliente"
    },
    "servico_personalizado": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o livre quando o cliente escolhe \u00abN\u00e3o encontro o que procuro\u00bb"
    },
    "nome_pedido": {
      "type": "string"
    },
    "objetivo": {
      "type": "string"
    },
    "descricao": {
      "type": "string",
      "description": "Resultado pretendido descrito pelo cliente"
    },
    "estilo_visual": {
      "type": "string"
    },
    "intensidade": {
      "type": "string"
    },
    "realismo": {
      "type": "string"
    },
    "formato_final": {
      "type": "string"
    },
    "resolucao": {
      "type": "string"
    },
    "variacoes": {
      "type": "number",
      "default": 1
    },
    "observacoes": {
      "type": "string"
    },
    "respostas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Perguntas condicionais respondidas, no formato \u00abPergunta: resposta\u00bb"
    },
    "imagem_original_uri": {
      "type": "string",
      "description": "URI privado da imagem original carregada pelo cliente"
    },
    "imagem_referencia_uri": {
      "type": "string",
      "description": "URI privado da imagem de refer\u00eancia, quando fornecida"
    },
    "referencia_tipo": {
      "type": "string",
      "description": "Tipo de refer\u00eancia: estilo, roupa, cen\u00e1rio, ilumina\u00e7\u00e3o, pose, composi\u00e7\u00e3o ou outra"
    },
    "referencia_notas": {
      "type": "string"
    },
    "nome_cliente": {
      "type": "string"
    },
    "email_cliente": {
      "type": "string"
    },
    "autorizacao_imagens": {
      "type": "boolean",
      "default": false,
      "description": "Confirma\u00e7\u00e3o de que o cliente tem autoriza\u00e7\u00e3o para utilizar as imagens carregadas"
    },
    "novidades": {
      "type": "boolean",
      "default": false,
      "description": "Consentimento opcional para comunica\u00e7\u00f5es de marketing"
    },
    "estado": {
      "type": "string",
      "enum": [
        "recebido",
        "em_analise",
        "em_producao",
        "concluido",
        "cancelado"
      ],
      "default": "recebido"
    },
    "notas_internas": {
      "type": "string",
      "description": "Notas internas da equipa de produ\u00e7\u00e3o"
    }
  },
  "required": [
    "referencia",
    "servico_principal",
    "nome_pedido"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}