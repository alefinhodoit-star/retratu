{
  "name": "Package",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome comercial do pacote (ex.: Pacote Principal)"
    },
    "slug": {
      "type": "string",
      "description": "Identificador curto usado no checkout"
    },
    "preco": {
      "type": "number",
      "description": "Pre\u00e7o final em euros, com IVA a 23% inclu\u00eddo"
    },
    "tag": {
      "type": "string",
      "description": "Etiqueta curta apresentada no cart\u00e3o (ex.: Recomendado)"
    },
    "descricao": {
      "type": "string"
    },
    "inclui": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista do que est\u00e1 inclu\u00eddo no pacote"
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Cart\u00e3o em destaque (Mais Popular)"
    },
    "ordem": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome",
    "preco"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}