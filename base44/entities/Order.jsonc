{
  "name": "Order",
  "type": "object",
  "properties": {
    "referencia": {
      "type": "string",
      "description": "C\u00f3digo da encomenda que agrupa os artigos comprados juntos"
    },
    "pacote_slug": {
      "type": "string"
    },
    "pacote_nome": {
      "type": "string"
    },
    "preco_base": {
      "type": "number"
    },
    "quantidade": {
      "type": "number",
      "default": 1
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identificadores das op\u00e7\u00f5es adicionais escolhidas"
    },
    "extras_total": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "description": "Total final em euros, com IVA a 23% inclu\u00eddo"
    },
    "iva_taxa": {
      "type": "number",
      "default": 23
    },
    "nome_cliente": {
      "type": "string"
    },
    "email_cliente": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendente_pagamento",
        "pago",
        "em_producao",
        "concluido",
        "cancelado"
      ],
      "default": "pendente_pagamento"
    },
    "aprovado_por": {
      "type": "string",
      "description": "E-mail do administrador que aprovou o pedido"
    },
    "historico": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Registo das altera\u00e7\u00f5es de estado feitas pela administra\u00e7\u00e3o"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "pacote_slug",
    "total"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}