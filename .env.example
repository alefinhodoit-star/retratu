# Copie para `.env` e preencha antes de arrancar em produção.
# O `.env` está no .gitignore — nunca o versione.

# Porta onde a API (e o site, em produção) escuta.
PORT=3001

# Origem autorizada para CORS. Em produção deve ser o domínio real.
APP_ORIGIN=https://retratu.pt

# Segredo usado para assinar os JWT. Gere com:
#   openssl rand -hex 48
# Se ficar vazio, o servidor gera um automaticamente em data/.jwt-secret —
# funciona, mas perde a sessão se apagar a pasta data/.
JWT_SECRET=
